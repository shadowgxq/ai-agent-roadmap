CODEX_API_KEY=your-api-key
CODEX_BASE_URL=http://165.154.255.250:8080
CODEX_MODEL=gpt-5.6-luna
LOG_FILE=logs/agent.json
CONTEXT_WINDOW_TOKENS=128000
PRICE_CURRENCY=USD
INPUT_PRICE_PER_MILLION=1.0
OUTPUT_PRICE_PER_MILLION=6.0
CACHE_READ_PRICE_PER_MILLION=0.1
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_KEY=agent-mini
# PROMPT_CACHE_RETENTION=24h

COMPACT_ENABLED=true
COMPACT_THRESHOLD=0.7
COMPACT_KEEP_RECENT=4
COMPACT_MAX_TOKENS=1000
# COMPACT_MODEL=your-small-model
# Different compact models require their own prices for cost accounting.
# COMPACT_INPUT_PRICE_PER_MILLION=0.0
# COMPACT_OUTPUT_PRICE_PER_MILLION=0.0
# COMPACT_CACHE_READ_PRICE_PER_MILLION=0.0
# COMPACT_CACHE_CREATION_PRICE_PER_MILLION=0.0

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://api.openai.com

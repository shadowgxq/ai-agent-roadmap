# Copy this file to .env and replace the placeholder values.
SUPPORT_AGENT_MODEL=your-model-id
SUPPORT_AGENT_API_KEY=your-api-key
# Optional OpenAI-compatible gateway, for example: https://api.example.com/v1
# SUPPORT_AGENT_BASE_URL=
SUPPORT_AGENT_TIMEOUT_SECONDS=30
SUPPORT_AGENT_MAX_RUN_COST_USD=0.50
SUPPORT_AGENT_DEEPSEEK_THINKING_MODE=disabled
# Local W15 PostgreSQL started by the repository compose.yaml.
SUPPORT_AGENT_DATABASE_URL=postgresql://support_agent:support_agent@localhost:5432/support_agent
# W19: must match the provider embedding model and actual output dimensions.
SUPPORT_AGENT_EMBEDDING_MODEL=text-embedding-3-small

# W20 application. API: uvicorn support_agent.application.api:create_app --factory
# Worker: celery -A support_agent.application.queue:celery_app worker
# Scheduler/outbox recovery: celery -A support_agent.application.queue:celery_app beat
# Run `alembic upgrade head` before starting the application; W15 initializes checkpoints on first worker use.
SUPPORT_APP_DATABASE_URL=postgresql://support_agent:support_agent@localhost:5432/support_agent
SUPPORT_APP_REDIS_URL=redis://localhost:6379/0
SUPPORT_APP_SESSION_SECRET=
# Generate scrypt hashes locally with `support-app hash-password`. Provision roles server-side.
# Account shape: {"username":{"password_hash":"salt:hash","organization_id":"org","user_id":"user","role":"operator"}}
SUPPORT_APP_ACCOUNTS={}
SUPPORT_APP_ALLOWED_ORIGINS=["http://localhost:5173"]
# Local HTTP only. Use true for HTTPS deployment.
SUPPORT_APP_SECURE_COOKIE=false
